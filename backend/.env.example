# Copy to .env and adjust. docker-compose reads these.

# Postgres
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_DB=lifeos

# Backend (only needed if running uvicorn outside Docker)
DATABASE_URL=postgresql+psycopg2://lifeos:lifeos@localhost:5432/lifeos
ENVIRONMENT=development

# ollama local LLM (Jetson Orin Nano). Points to the lifeos-ollama systemd service.
OPENCLAW_BASE_URL=http://host.docker.internal:11434
OPENCLAW_MODEL=qwen3.5:4b
OPENCLAW_API_KEY=

# Auto execution detection — local git repos on the machine running the backend.
EXECUTION_REPO_PATHS=
EXECUTION_GIT_AUTHOR=

# GitHub execution detection via the official github-mcp-server sidecar.
# The MCP server runs as a docker-compose service; GITHUB_TOKEN is its auth credential.
# Token: fine-grained or classic PAT with read access to the repos below.
GITHUB_TOKEN=
GITHUB_REPOS=ajmalrasi/life_os
GITHUB_USER=

# Live phone health pull (chat `live_health` tool). HAE_HOST is the iPhone's LAN
# IP running Health Auto Export's TCP server (Automations -> Server). DHCP — set a
# router reservation or update when it changes. Leave blank to disable the tool.
HAE_HOST=
HAE_PORT=9000

# Push notifications (Firebase Cloud Messaging, HTTP v1). Leave blank to disable.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
