# Copy to .env and adjust. docker-compose reads these.

# Postgres
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_DB=lifeos

# Backend (only needed if running uvicorn outside Docker)
DATABASE_URL=postgresql+psycopg2://lifeos:lifeos@localhost:5432/lifeos
ENVIRONMENT=development

# OpenClaw local LLM (Jetson Orin Nano). Point this at your server.
OPENCLAW_BASE_URL=http://localhost:8080
OPENCLAW_MODEL=openclaw
OPENCLAW_API_KEY=

# Auto execution detection — local git repos on the machine running the backend.
# OpenClaw/MCP agents can also POST to /github; this is the zero-input baseline.
EXECUTION_REPO_PATHS=/Users/you/projects/life_os
EXECUTION_GIT_AUTHOR=

# GitHub API execution detection — supplements the local git scan so commits
# pushed from other machines (or when the backend runs in Docker) are still
# counted. Runs during recompute and is deduplicated against the local scan by
# commit SHA. Leave GITHUB_TOKEN blank to disable.
# Token: a fine-grained or classic PAT with read access to the repos below.
GITHUB_TOKEN=
GITHUB_REPOS=kpajmalrasi/life_os
GITHUB_USER=

# Push notifications (Firebase Cloud Messaging, HTTP v1). Leave blank to disable
# push — the backend still generates notifications for the client to poll.
# Requires the 'google-auth' package and a Firebase service-account JSON.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
