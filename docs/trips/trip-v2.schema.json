{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.local/schemas/trip-v2.schema.json",
  "title": "LifeOS Trip Import v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trip", "days"],
  "properties": {
    "schema_version": { "const": 2 },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "start_date", "end_date", "timezone"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "title": { "type": "string", "minLength": 1 },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "examples": ["Asia/Kolkata"] },
        "currency": { "type": "string", "default": "INR" },
        "original_text": { "type": ["string", "null"] }
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "address": { "type": ["string", "null"] },
          "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
          "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
          "google_place_id": { "type": ["string", "null"] },
          "kind": {
            "type": "string",
            "enum": [
              "attraction",
              "area",
              "neighborhood",
              "airport",
              "metro_station",
              "railway_station",
              "bus_station",
              "bus_stop",
              "hotel",
              "lodging",
              "restaurant",
              "cafe",
              "monument",
              "shopping",
              "office",
              "transit_hub",
              "other"
            ]
          },
          "station_code": { "type": ["string", "null"] },
          "city": { "type": ["string", "null"] },
          "verification": { "enum": ["unresolved", "supplied", "verified"] }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "title", "activities"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "title": { "type": "string" },
          "activities": {
            "type": "array",
            "items": { "$ref": "#/$defs/activity" }
          }
        }
      }
    },
    "reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "note": { "type": ["string", "null"] },
          "activity_id": { "type": ["string", "null"] },
          "local_date_time": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": {
          "enum": [
            "arrival",
            "departure",
            "visit",
            "event",
            "meal",
            "rest",
            "transport",
            "transit",
            "reminder"
          ]
        },
        "start_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "duration_minutes": { "type": ["integer", "null"], "minimum": 0 },
        "place_id": { "type": ["string", "null"] },
        "from_place_id": { "type": ["string", "null"] },
        "to_place_id": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "flexibility": { "enum": ["fixed", "flexible", "optional", "conditional"] },
        "condition": { "type": ["string", "null"] },
        "transport_mode": { "type": ["string", "null"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/transit_step" }
        },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternative" }
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "condition"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "condition": { "type": "string" },
        "place_id": { "type": ["string", "null"] },
        "from_place_id": { "type": ["string", "null"] },
        "to_place_id": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "transport_mode": { "type": ["string", "null"] },
        "duration_minutes": { "type": ["integer", "null"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/transit_step" }
        }
      }
    },
    "transit_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_order", "mode", "title"],
      "properties": {
        "step_order": { "type": "integer", "minimum": 1 },
        "mode": {
          "enum": [
            "metro",
            "train",
            "car",
            "bus",
            "flight",
            "walk",
            "ferry",
            "bicycle",
            "other"
          ]
        },
        "title": { "type": "string" },
        "duration_minutes": { "type": ["integer", "null"], "minimum": 0 },
        "distance_km": { "type": ["number", "null"], "minimum": 0 },
        "distance_meters": { "type": ["integer", "null"], "minimum": 0 },
        "departure": { "$ref": "#/$defs/transit_endpoint" },
        "arrival": { "$ref": "#/$defs/transit_endpoint" },
        "transit_details": { "$ref": "#/$defs/transit_details" },
        "instructions": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "transit_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place_id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "station_name": { "type": ["string", "null"] },
        "station_code": { "type": ["string", "null"] },
        "terminal": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] },
        "gate": { "type": ["string", "null"] },
        "exit_gate": { "type": ["string", "null"] },
        "pickup_location": { "type": ["string", "null"] },
        "dropoff_location": { "type": ["string", "null"] },
        "scheduled_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "transit_details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line_name": { "type": ["string", "null"] },
        "line_color": { "type": ["string", "null"] },
        "line_code": { "type": ["string", "null"] },
        "direction": { "type": ["string", "null"] },
        "route_number": { "type": ["string", "null"] },
        "service_number": { "type": ["string", "null"] },
        "service_name": { "type": ["string", "null"] },
        "operator": { "type": ["string", "null"] },
        "stops_count": { "type": ["integer", "null"], "minimum": 0 },
        "intermediate_stops": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frequency_minutes": { "type": ["integer", "null"], "minimum": 1 },
        "interchange_notes": { "type": ["string", "null"] },
        "road_type": {
          "enum": [
            "rideshare",
            "taxi",
            "personal_car",
            "rental_car",
            "auto_rickshaw",
            "e_rickshaw",
            "shuttle",
            "other",
            null
          ]
        },
        "service_provider": { "type": ["string", "null"] },
        "vehicle_model": { "type": ["string", "null"] },
        "license_plate": { "type": ["string", "null"] },
        "driver_contact": { "type": ["string", "null"] },
        "route_name": { "type": ["string", "null"] },
        "train_number": { "type": ["string", "null"] },
        "train_name": { "type": ["string", "null"] },
        "coach": { "type": ["string", "null"] },
        "seat_or_berth": { "type": ["string", "null"] },
        "booking_class": { "type": ["string", "null"] },
        "pnr": { "type": ["string", "null"] },
        "airline": { "type": ["string", "null"] },
        "flight_number": { "type": ["string", "null"] },
        "boarding_group": { "type": ["string", "null"] },
        "boarding_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "baggage_belt": { "type": ["string", "null"] },
        "instructions": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "fare": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["amount"],
          "properties": {
            "amount": { "type": "string" },
            "currency": { "type": "string", "default": "INR" }
          }
        }
      }
    }
  }
}
